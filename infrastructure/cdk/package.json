{
  "name": "@alexa-independence/infra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:lambda": "cd lambda/reminder-handler && npm install && npm run build && cp package.json dist/ && cp -r node_modules dist/node_modules",
    "deploy": "npm run build:lambda && cdk deploy",
    "synth": "npm run build:lambda && cdk synth"
  },
  "devDependencies": {
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.4.0",
    "typescript": "^5.9.0",
    "@types/node": "^20.14.0"
  }
}
